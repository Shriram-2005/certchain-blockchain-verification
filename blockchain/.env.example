# ╔══════════════════════════════════════════════════╗
# ║  Blockchain .env — fill these for Sepolia deploy  ║
# ╚══════════════════════════════════════════════════╝

# From alchemy.com → Create App → Ethereum Sepolia
ALCHEMY_API_KEY=your_alchemy_api_key

# Private key of the Ethereum wallet that will deploy + issue certificates
# Get test ETH from: sepoliafaucet.com (0.5 ETH/day free)
# NEVER commit this to git!
ISSUER_PRIVATE_KEY=0x...

# From etherscan.io → API Keys (for contract verification, optional)
ETHERSCAN_API_KEY=your_etherscan_api_key
